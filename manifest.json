{
 "name": "Tayb Office",
 "short_name": "Tayb Office",
 "start_url": "./index.html",
 "display": "standalone",
 "background_color": "#0b6b3a",
 "theme_color": "#0b6b3a",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png"
  }
 ],
 "share_target": {
  "action": "./share",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "files": [
    {
     "name": "file",
     "accept": [
      ".xlsx",
      ".docx",
      ".pdf",
      ".txt",
      ".csv",
      ".json",
      ".md",
      ".html",
      ".xml",
      ".log",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/pdf",
      "text/plain",
      "text/csv",
      "application/json"
     ]
    }
   ]
  }
 }
}